# GridSense Environment Configuration Template
# Copy this file to .env and configure local secrets

# MQTT Broker Configuration (Local Mosquitto)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=gridsense/feeder1/telemetry
MQTT_CLIENT_ID=gridsense_bridge

# MySQL Time-Series & Telemetry Storage
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=gridsense

# Risk Prediction Microservice (OpenRouter LLM + Local Inference)
RISK_API_HOST=127.0.0.1
RISK_API_PORT=8001
RISK_API_URL=http://127.0.0.1:8001
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Backend Orchestration API
BACKEND_API_HOST=127.0.0.1
BACKEND_API_PORT=8000
BACKEND_API_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:5173
